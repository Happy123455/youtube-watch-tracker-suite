{
  "manifest_version": 3,
  "name": "YouTube Watch Tracker & Obsidian Linker",
  "version": "2.1.0",
  "description": "Tracks YouTube watch history (videos and Shorts), syncs it once a day from Chrome and your YouTube account, and sorts useful from entertainment with AI, and checks the logic of what a video says (🧯 rhetoric firewall).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Watch Tracker"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "utils/yt-core.js",
        "content/content.js",
        "utils/fw-core.js",
        "utils/fw-view.js",
        "content/firewall-panel.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "unlimitedStorage",
    "declarativeNetRequest",
    "history",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com/ https://*.youtube.com/ https://www.youtube-nocookie.com/;"
  }
}
